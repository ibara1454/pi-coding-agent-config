{
  "$schema": "./schemas/sandbox.schema.json",
  "enabled": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowedDomains": ["github.com", "*.github.com"],
    "deniedDomains": []
  },
  "filesystem": {
    "allowRead": [".", "~/.gitconfig", "~/.config", "~/.local", "Library"],
    "denyRead": ["/Users", "/home", "~/.ssh"],
    "allowWrite": [".", "/tmp"],
    "denyWrite": [".env", ".env.*", "*.pem", "*.key"]
  }
}
