{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["index.ts"],
      "linter": {
        "rules": {
          "style": {
            // Pi loads extension entrypoints through their default-exported factories.
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
