{
  "name": "omp-welcome",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test --preload ../../test/setup.ts",
    "test:coverage": "bun test --cwd=../.. ./apps/omp-welcome --coverage --coverage-dir=./apps/omp-welcome/coverage --only-failures",
    "test:stress": "bun test --preload ../../test/setup.ts --isolate --randomize --rerun-each 5",
    "typecheck": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/semver": "7.8.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
