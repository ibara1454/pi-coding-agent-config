{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "complexity": {
        // Explicit defaults replace the root's higher rollout limits.
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 50 }
        }
      },
      "performance": {
        "noAwaitInLoops": "error"
      },
      "style": {
        "noContinue": "error",
        "noExcessiveClassesPerFile": "error",
        "noExcessiveLinesPerFile": "error",
        "noIncrementDecrement": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["index.ts"],
      "linter": {
        "rules": {
          "style": {
            // Pi loads extension entrypoints through their default-exported factories.
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
