{
  "name": "omp-extension-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test --cwd=../.. ./apps/omp-extension-manager --coverage --coverage-dir=./apps/omp-extension-manager/coverage --only-failures",
    "test:stress": "bun test --preload ../../test/setup.ts --isolate --randomize --rerun-each 5",
    "typecheck": "bun check --project tsconfig.json"
  },
  "dependencies": {
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
