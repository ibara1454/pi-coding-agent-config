{
  "name": "sandbox",
  "private": true,
  "version": "1.14.1",
  "type": "module",
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test --preload ../../test/setup.ts",
    "test:coverage": "bun test --preload ../../test/setup.ts --coverage --coverage-reporter=text",
    "test:stress": "bun test --preload ../../test/setup.ts --isolate --randomize --rerun-each 5",
    "typecheck": "tsc --project tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "deepmerge": "4.3.1"
  }
}
