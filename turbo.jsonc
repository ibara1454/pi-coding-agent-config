{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "test/setup.ts",
    "bunfig.toml",
    "biome.jsonc",
    // All workspaces load this plugin through the root Biome config.
    // Track its exports, presets, and rules to invalidate cached lint results.
    "packages/biome-rules/package.json",
    "packages/biome-rules/biome-manifest.json",
    "packages/biome-rules/src/*.grit",
    "tsconfig.base.json"
  ],
  "tasks": {
    "lint": {
      "cache": true,
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:stress": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    }
  }
}
