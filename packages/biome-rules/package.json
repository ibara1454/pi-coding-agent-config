{
  "name": "biome-rules",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/wasm-nodejs": "2.5.14"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test --cwd=../.. ./packages/biome-rules --coverage --coverage-dir=./packages/biome-rules/coverage --only-failures",
    "test:stress": "bun test --preload ../../test/setup.ts --isolate --randomize --rerun-each 5",
    "typecheck": "tsc --project tsconfig.json"
  }
}
