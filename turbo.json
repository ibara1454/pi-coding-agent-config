{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "test/setup.ts",
    "bunfig.toml",
    "biome.json",
    "packages/biome-rules/src/*.grit",
    "tsconfig.base.json"
  ],
  "tasks": {
    "lint": {
      "cache": true,
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": true,
      "outputs": []
    },
    "test:coverage": {
      "cache": false,
      "outputs": []
    },
    "test:stress": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    }
  }
}
